# ── LLM ──────────────────────────────────────────────────────────────────────
# DeepSeek example:  LLM_MODEL=deepseek/deepseek-chat
# OpenAI example:    LLM_MODEL=gpt-4o
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o
# LLM_API_BASE=      # override only if using a custom/self-hosted endpoint
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2048

# ── Embeddings ────────────────────────────────────────────────────────────────
# Falls back to LLM_API_KEY when not set; override for a different provider
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_BASE=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_USERNAME=postgres
PG_PASSWORD=postgres
# Docker Compose: use service name "postgres"; local dev: use "localhost"
PG_HOST=postgres
PG_DB=ragdb

# ── OpenSearch ────────────────────────────────────────────────────────────────
# Docker Compose: use service name "opensearch"; local dev: use "localhost"
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_KNN_SIZE=10
OPENSEARCH_DIMENSIONS=1536
OPENSEARCH_INDEX=rag-documents

# ── MinIO ─────────────────────────────────────────────────────────────────────
# Docker Compose: use "minio:9000"; local dev: use "localhost:9000"
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=rag-documents

# ── RAG pipeline tuning ───────────────────────────────────────────────────────
MAX_RETRIES=3
QUERY_EXPANSION_COUNT=3
RETRIEVAL_TOP_K=5
